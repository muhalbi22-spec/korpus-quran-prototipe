{
  // Konfigurasi Worker untuk purwarupa korpus Al-Qur’an terjemahan Indonesia.
  // Nama harus sama dengan nama proyek di Cloudflare.
  "name": "korpus-quran-prototipe",
  "main": "worker.js",
  "compatibility_date": "2025-09-09",

  // Folder situs statis (dibuat oleh Build command: mkdir -p public && cp index.html public/)
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  // Akses ke Workers AI, dipakai oleh /api/cari untuk pencarian makna (eksperimen)
  "ai": {
    "binding": "AI"
  },

  // Pembatas laju ketat (Durable Object PembatasLaju di worker.js). Lab label terbuka tanpa kunci, jadi dibatasi
  // per pengunjung dan total; pencarian makna dibatasi per pengunjung. Angka batas ada di konstanta BATAS.
  "durable_objects": {
    "bindings": [{ "name": "PEMBATAS", "class_name": "PembatasLaju" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PembatasLaju"] }]
}
